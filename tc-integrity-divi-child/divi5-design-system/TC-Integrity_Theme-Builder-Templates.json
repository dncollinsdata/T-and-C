                },
                "column_3": {
                  "module": "text",
                  "title": "Service Areas",
                  "content_html": "<ul style='list-style:none;padding:0;'><li><a href='/service-area/houston/' style='color:rgba(255,255,255,0.75);text-decoration:none;padding:4px 0;display:block;'>Houston, TX</a></li><li><a href='/service-area/sugar-land/' style='color:rgba(255,255,255,0.75);text-decoration:none;padding:4px 0;display:block;'>Sugar Land, TX</a></li><li><a href='/service-area/katy/' style='color:rgba(255,255,255,0.75);text-decoration:none;padding:4px 0;display:block;'>Katy, TX</a></li><li><a href='/service-area/cypress/' style='color:rgba(255,255,255,0.75);text-decoration:none;padding:4px 0;display:block;'>Cypress, TX</a></li><li><a href='/service-area/college-station/' style='color:rgba(255,255,255,0.75);text-decoration:none;padding:4px 0;display:block;'>College Station, TX</a></li><li><a href='/service-area/' style='color:#81C784;text-decoration:none;padding:4px 0;display:block;font-weight:600;'>View All Areas →</a></li></ul>"
                },
                "column_4": {
                  "module": "text",
                  "title": "Contact Us",
                  "content_html": "<p style='color:rgba(255,255,255,0.75);font-size:14px;line-height:2;'><strong style='color:#ffffff;'>Phone:</strong><br><a href='tel:+15551234567' style='color:#81C784;text-decoration:none;font-weight:600;'>(555) 123-4567</a></p><p style='color:rgba(255,255,255,0.75);font-size:14px;line-height:2;'><strong style='color:#ffffff;'>Email:</strong><br><a href='mailto:info@tcintegritytrash.com' style='color:#81C784;text-decoration:none;'>info@tcintegritytrash.com</a></p><p style='color:rgba(255,255,255,0.75);font-size:14px;line-height:2;'><strong style='color:#ffffff;'>Hours:</strong><br>Mon-Sat: 7AM - 7PM<br>Sun: By Appointment</p>"
                }
              }
            }
          },
          {
            "name": "Footer Bottom Bar",
            "description": "Copyright bar at very bottom",
            "layout": {
              "type": "section",
              "background": "#0d1f0d",
              "padding": "20px 0",
              "row": {
                "columns": "1_2,1_2",
                "column_1": {
                  "module": "text",
                  "content": "<span style='color:rgba(255,255,255,0.5);font-size:13px;'>© 2026 T&C Integrity & Reliable Trash Services. All rights reserved.</span>"
                },
                "column_2": {
                  "module": "text",
                  "alignment": "right",
                  "content": "<a href='/privacy-policy/' style='color:rgba(255,255,255,0.4);font-size:13px;text-decoration:none;'>Privacy Policy</a> &nbsp;|&nbsp; <a href='/terms/' style='color:rgba(255,255,255,0.4);font-size:13px;text-decoration:none;'>Terms of Service</a>"
                }
              }
            }
          }
        ]
      },
      "body": {
        "id": "tc-global-body",
        "description": "Uses default Post Content module to render each page's Divi Builder content."
      }
