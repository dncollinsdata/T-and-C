0;display:block;\">Property Cleanout</a></li><li><a href=\"/services/debris-cleanup/\" style=\"color:rgba(255,255,255,0.75);text-decoration:none;padding:4px 0;display:block;\">Debris Cleanup</a></li></ul>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_4\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h4 style=\"color:#ffffff;font-family:Montserrat;font-weight:700;\">Service Areas</h4>\n<ul style=\"list-style:none;padding:0;\"><li><a href=\"/service-area/houston/\" style=\"color:rgba(255,255,255,0.75);text-decoration:none;padding:4px 0;display:block;\">Houston, TX</a></li><li><a href=\"/service-area/sugar-land/\" style=\"color:rgba(255,255,255,0.75);text-decoration:none;padding:4px 0;display:block;\">Sugar Land, TX</a></li><li><a href=\"/service-area/katy/\" style=\"color:rgba(255,255,255,0.75);text-decoration:none;padding:4px 0;display:block;\">Katy, TX</a></li><li><a href=\"/service-area/cypress/\" style=\"color:rgba(255,255,255,0.75);text-decoration:none;padding:4px 0;display:block;\">Cypress, TX</a></li><li><a href=\"/service-area/college-station/\" style=\"color:rgba(255,255,255,0.75);text-decoration:none;padding:4px 0;display:block;\">College Station, TX</a></li><li><a href=\"/service-area/\" style=\"color:#81C784;text-decoration:none;padding:4px 0;display:block;font-weight:600;\">View All Areas &rarr;</a></li></ul>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_4\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h4 style=\"color:#ffffff;font-family:Montserrat;font-weight:700;\">Contact Us</h4>\n<p style=\"color:rgba(255,255,255,0.75);font-size:14px;line-height:2;\"><strong style=\"color:#ffffff;\">Phone:</strong><br><a href=\"tel:+15551234567\" style=\"color:#81C784;text-decoration:none;font-weight:600;\">(555) 123-4567</a></p>\n<p style=\"color:rgba(255,255,255,0.75);font-size:14px;line-height:2;\"><strong style=\"color:#ffffff;\">Email:</strong><br><a href=\"mailto:info@tcintegritytrash.com\" style=\"color:#81C784;text-decoration:none;\">info@tcintegritytrash.com</a></p>\n<p style=\"color:rgba(255,255,255,0.75);font-size:14px;line-height:2;\"><strong style=\"color:#ffffff;\">Hours:</strong><br>Mon-Sat: 7AM - 7PM<br>Sun: By Appointment</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#0d1f0d\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"20px||20px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_2,1_2\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<span style=\"color:rgba(255,255,255,0.5);font-size:13px;\">&copy; 2026 T&amp;C Integrity &amp; Reliable Trash Services. All rights reserved.</span>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"text\": {\"text_orientation\": {\"desktop\": {\"value\": \"right\"}}}}}} -->\n<a href=\"/privacy-policy/\" style=\"color:rgba(255,255,255,0.4);font-size:13px;text-decoration:none;\">Privacy Policy</a> &nbsp;|&nbsp; <a href=\"/terms/\" style=\"color:rgba(255,255,255,0.4);font-size:13px;text-decoration:none;\">Terms of Service</a>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- /wp:divi/placeholder -->"
