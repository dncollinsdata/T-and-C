{
  "context": "et_theme_builder",
  "templates": [
    {
      "id": "tc-global-template",
      "title": "TC Global Template",
      "default": true,
      "enabled": true,
      "header": {
        "id": "tc-global-header",
        "title": "TC Global Header",
        "description": "Top utility bar + main navigation with logo. Green utility bar, white nav background, Montserrat menu links.",
        "build_instructions": "Build this header in Divi > Theme Builder using these sections:",
        "sections": [
          {
            "name": "Top Utility Bar",
            "description": "Thin dark green bar above main nav with hours and phone CTA",
            "layout": {
              "type": "section",
              "background": "#1B5E20",
              "padding": "8px 0",
              "row": {
                "columns": "1_2,1_2",
                "column_1": {
                  "module": "text",
                  "content": "<span style='color:rgba(255,255,255,0.9);font-size:14px;font-weight:500;'>Mon-Sat: 7AM - 7PM</span>"
                },
                "column_2": {
                  "module": "text",
                  "alignment": "right",
                  "content": "<a href='tel:+15551234567' style='color:#81C784;font-size:14px;font-weight:600;text-decoration:none;'>&#9742; (555) 123-4567 — Free Estimates</a>"
                }
              }
            }
          },
          {
            "name": "Main Navigation",
            "description": "Logo left, menu right, white background",
            "layout": {
              "type": "section",
              "background": "#ffffff",
              "box_shadow": "0 2px 10px rgba(0,0,0,0.08)",
              "row": {
                "columns": "1_4,3_4",
                "column_1": {
                  "module": "image",
                  "description": "Upload T&C logo here",
                  "max_height": "54px"
                },
                "column_2": {
                  "module": "menu",
                  "menu_source": "primary-menu",
                  "alignment": "right",
                  "font": "Montserrat, 15px, Bold, Uppercase",
                  "text_color": "#1a2e1a",
                  "active_color": "#2E7D32",
                  "dropdown_bg": "#ffffff",
                  "dropdown_text": "#333333",
                  "dropdown_line_color": "#4CAF50",
                  "mobile_bg": "#1B5E20",
                  "mobile_text": "#ffffff"
                }
              }
            }
          }
        ]
      },
      "footer": {
        "id": "tc-global-footer",
