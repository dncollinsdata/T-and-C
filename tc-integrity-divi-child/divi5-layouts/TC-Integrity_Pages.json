{"context": "et_builder_layouts", "data": {"1001": {"ID": 1001, "post_date": "2026-04-15 05:00:00", "post_date_gmt": "2026-04-15 05:00:00", "post_content": "<!-- wp:divi/placeholder -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#1B5E20\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"120px||120px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h1 style=\"text-align:center;color:#ffffff;font-family:Montserrat;font-size:48px;font-weight:800;\">Professional Eviction Junk Removal &amp; Deep Cleaning</h1><p style=\"text-align:center;color:rgba(255,255,255,0.95);font-size:18px;\">T&amp;C Integrity &amp; Reliable Trash Services — trusted by property managers, landlords, and homeowners for fast, thorough, and affordable cleanout solutions.</p><p style=\"text-align:center;\"><a href=\"/contact/\" style=\"background:#4CAF50;color:#fff;padding:16px 40px;border-radius:50px;text-decoration:none;font-family:Montserrat;font-weight:700;text-transform:uppercase;letter-spacing:1px;display:inline-block;margin:8px;\">Get a Free Estimate</a> <a href=\"tel:+15551234567\" style=\"border:2px solid #fff;color:#fff;padding:16px 40px;border-radius:50px;text-decoration:none;font-family:Montserrat;font-weight:700;text-transform:uppercase;letter-spacing:1px;display:inline-block;margin:8px;\">Call Now</a></p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#f5f9f3\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"60px||60px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_4,1_4,1_4,1_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_4\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>Licensed &amp; Insured</h4>\n<p>Fully licensed and insured for your protection and peace of mind.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_4\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>Eco-Friendly</h4>\n<p>We recycle and donate usable items to minimize landfill waste.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_4\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>Same-Day Service</h4>\n<p>Urgent cleanout? We offer same-day and next-day scheduling.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_4\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>Upfront Pricing</h4>\n<p>No hidden fees. Get a transparent quote before any work begins.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#ffffff\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"80px||80px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"text-align:center;font-family:Montserrat;color:#1a2e1a;\">Our Services</h2><p style=\"text-align:center;color:#666;\">From eviction cleanouts to deep cleaning — we handle it all with integrity and professionalism.</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row --><!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_3,1_3,1_3\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>Eviction Junk Removal</h4>\n<p>Complete property cleanouts after eviction. We remove all debris, abandoned belongings, and hazardous materials, leaving the unit turnover-ready.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>Deep Cleaning Services</h4>\n<p>Professional deep cleaning for post-eviction, move-in/move-out, and property rehabilitation. Every surface sanitized and restored.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>Furniture &amp; Appliance Removal</h4>\n<p>Heavy items hauled away responsibly. Couches, mattresses, refrigerators, washers — we handle the heavy lifting.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row --><!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_3,1_3,1_3\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>Property Cleanout</h4>\n<p>Full estate or rental property cleanouts. We clear everything from attic to basement efficiently.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>Debris &amp; Construction Cleanup</h4>\n<p>Post-renovation debris removal. Drywall, lumber, tile, flooring — removed and hauled to proper disposal.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>Yard Waste &amp; Outdoor Cleanup</h4>\n<p>Overgrown yards, fallen branches, old fencing cleared to improve curb appeal and property value.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row --><!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/button {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"url\": {\"desktop\": {\"value\": \"/services/\"}}}}} -->\nView All Services\n<!-- /wp:divi/button -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#f5f9f3\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"80px||80px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"text-align:center;font-family:Montserrat;color:#1a2e1a;\">How It Works</h2><p style=\"text-align:center;color:#666;\">Three simple steps to a clean property.</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row --><!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_3,1_3,1_3\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>1. Book Your Estimate</h4>\n<p>Call us or fill out our online form. We'll schedule a free, no-obligation on-site estimate.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>2. We Do the Work</h4>\n<p>Our professional crew arrives on time, removes all junk, and performs deep cleaning as needed.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>3. Property Ready</h4>\n<p>Your property is clean, sanitized, and ready for new tenants, sale, or renovation.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"gradient\": {\"stops\": [{\"color\": \"#1B5E20\", \"position\": 0}, {\"color\": \"#2E7D32\", \"position\": 100}], \"direction\": \"135deg\"}, \"type\": \"gradient\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"50px||50px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_4,1_4,1_4,1_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_4\"}}}}} -->\n<!-- wp:divi/number-counter {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"number\": {\"desktop\": {\"value\": \"500\"}}}}} -->\nProperties Cleaned\n<!-- /wp:divi/number-counter -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_4\"}}}}} -->\n<!-- wp:divi/number-counter {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"number\": {\"desktop\": {\"value\": \"100\"}}}}} -->\n5-Star Reviews\n<!-- /wp:divi/number-counter -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_4\"}}}}} -->\n<!-- wp:divi/number-counter {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"number\": {\"desktop\": {\"value\": \"10\"}}}}} -->\nYears Experience\n<!-- /wp:divi/number-counter -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_4\"}}}}} -->\n<!-- wp:divi/number-counter {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"number\": {\"desktop\": {\"value\": \"98\"}}}}} -->\nSatisfaction Rate\n<!-- /wp:divi/number-counter -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#ffffff\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"80px||80px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_2,1_2\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<p style=\"text-align:center;color:#999;font-style:italic;\">[Upload team or truck photo here]</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"font-family:Montserrat;color:#1a2e1a;\">Why Choose T&amp;C Integrity?</h2><p>We built our reputation on doing things right — with honesty, hard work, and attention to detail.</p><ul><li>Fully licensed, bonded, and insured</li><li>Background-checked, professional crew</li><li>Eco-friendly disposal and recycling</li><li>Transparent, upfront pricing — no surprises</li><li>Same-day and emergency service available</li><li>Serving property managers, realtors, and homeowners</li></ul>\n<!-- /wp:divi/text --><!-- wp:divi/button {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"url\": {\"desktop\": {\"value\": \"/contact/\"}}}}} -->\nGet Your Free Estimate\n<!-- /wp:divi/button -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#f5f9f3\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"80px||80px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"text-align:center;font-family:Montserrat;color:#1a2e1a;\">What Our Clients Say</h2>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row --><!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_3,1_3,1_3\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/testimonial {\"builderVersion\": \"5.2.1\"} -->\n<p>T&amp;C handled an eviction cleanout for me and had the unit turnover-ready in less than 24 hours. Professional, thorough, and affordable.</p>\n<cite>Sarah M., Property Manager</cite>\n<!-- /wp:divi/testimonial -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/testimonial {\"builderVersion\": \"5.2.1\"} -->\n<p>I've used several junk removal companies and T&amp;C is by far the best. Their deep cleaning service is top-notch.</p>\n<cite>Marcus J., Landlord</cite>\n<!-- /wp:divi/testimonial -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/testimonial {\"builderVersion\": \"5.2.1\"} -->\n<p>After my mother passed, T&amp;C helped clear out her house with care and respect. They donated what they could.</p>\n<cite>Linda P., Homeowner</cite>\n<!-- /wp:divi/testimonial -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"gradient\": {\"stops\": [{\"color\": \"#1B5E20\", \"position\": 0}, {\"color\": \"#2E7D32\", \"position\": 100}], \"direction\": \"135deg\"}, \"type\": \"gradient\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"70px||70px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/cta {\"builderVersion\": \"5.2.1\"} -->\n<h2>Ready for a Clean Start?</h2>\n<p>Get a free, no-obligation estimate today. We'll have your property looking its best — fast.</p>\n<!-- /wp:divi/cta -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#ffffff\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"60px||60px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"text-align:center;font-family:Montserrat;color:#1a2e1a;\">Areas We Serve</h2>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row --><!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_3,1_3,1_3\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h4>Houston Metro</h4><ul><li><a href=\"/service-area/houston/\">Houston</a></li><li><a href=\"/service-area/sugar-land/\">Sugar Land</a></li><li><a href=\"/service-area/missouri-city/\">Missouri City</a></li></ul>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h4>West Houston</h4><ul><li><a href=\"/service-area/katy/\">Katy</a></li><li><a href=\"/service-area/cypress/\">Cypress</a></li><li><a href=\"/service-area/richmond/\">Richmond</a></li></ul>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h4>Central Texas</h4><ul><li><a href=\"/service-area/rosenberg/\">Rosenberg</a></li><li><a href=\"/service-area/college-station/\">College Station</a></li><li><a href=\"/service-area/brenham/\">Brenham</a></li></ul>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- /wp:divi/placeholder -->", "post_title": "TC Integrity - Homepage", "post_excerpt": "", "post_status": "publish", "comment_status": "closed", "ping_status": "closed", "post_password": "", "post_name": "tc-integrity-homepage", "to_ping": "", "pinged": "", "post_modified": "2026-04-15 05:00:00", "post_modified_gmt": "2026-04-15 05:00:00", "post_content_filtered": "", "post_parent": 0, "menu_order": 0, "post_type": "et_pb_layout", "post_mime_type": "", "comment_count": "0", "filter": "raw", "post_meta": {"_et_pb_built_for_post_type": ["page"]}, "terms": {"3": {"name": "layout", "slug": "layout", "taxonomy": "layout_type", "parent": 0, "all_parents": [], "description": ""}}}, "1002": {"ID": 1002, "post_date": "2026-04-15 05:00:00", "post_date_gmt": "2026-04-15 05:00:00", "post_content": "<!-- wp:divi/placeholder -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#1B5E20\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"120px||120px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h1 style=\"text-align:center;color:#fff;font-family:Montserrat;font-size:48px;font-weight:800;\">Our Services</h1><p style=\"text-align:center;color:rgba(255,255,255,0.95);font-size:18px;\">Comprehensive junk removal and deep cleaning solutions for every property need.</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#ffffff\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"80px||80px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_2,1_2\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<p style=\"text-align:center;color:#999;font-style:italic;\">[Upload photo here]</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"font-family:Montserrat;color:#1a2e1a;\">Eviction Junk Removal</h2><p>When tenants leave behind a mess, we make it disappear.</p><ul><li>Abandoned furniture and personal belongings</li><li>Old mattresses, box springs, and bedding</li><li>Appliances (refrigerators, stoves, washers, dryers)</li><li>Electronics and e-waste</li><li>Trash bags, loose debris, and clutter</li><li>Hazardous materials (with proper handling)</li></ul><p><strong>Typical turnaround:</strong> 1-2 days from booking to completion.</p>\n<!-- /wp:divi/text --><!-- wp:divi/button {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"url\": {\"desktop\": {\"value\": \"/contact/\"}}}}} -->\nSchedule a Cleanout\n<!-- /wp:divi/button -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#f5f9f3\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"80px||80px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_2,1_2\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"font-family:Montserrat;color:#1a2e1a;\">Deep Cleaning Services</h2><p>Our professional deep cleaning restores properties to move-in ready condition.</p><ul><li>Kitchen deep clean — cabinets, appliances, counters, floors</li><li>Bathroom sanitization — toilets, tubs, tile, grout</li><li>Floor cleaning — sweep, mop, vacuum all surfaces</li><li>Wall and baseboard washing</li><li>Carpet shampooing and stain treatment</li><li>Odor removal and deodorizing</li></ul>\n<!-- /wp:divi/text --><!-- wp:divi/button {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"url\": {\"desktop\": {\"value\": \"/contact/\"}}}}} -->\nBook a Deep Clean\n<!-- /wp:divi/button -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<p style=\"text-align:center;color:#999;font-style:italic;\">[Upload photo here]</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#ffffff\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"80px||80px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_2,1_2\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<p style=\"text-align:center;color:#999;font-style:italic;\">[Upload photo here]</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"font-family:Montserrat;color:#1a2e1a;\">Furniture &amp; Appliance Removal</h2><p>Heavy, bulky items that regular trash won't take? That's our specialty.</p><ul><li>Sofas, recliners, and sectionals</li><li>Mattresses and bed frames</li><li>Dining tables, desks, and dressers</li><li>Refrigerators, ovens, dishwashers</li><li>Washers, dryers, and water heaters</li><li>TVs, computers, and electronics</li></ul>\n<!-- /wp:divi/text --><!-- wp:divi/button {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"url\": {\"desktop\": {\"value\": \"/contact/\"}}}}} -->\nGet a Quote\n<!-- /wp:divi/button -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#f5f9f3\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"80px||80px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_2,1_2\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"font-family:Montserrat;color:#1a2e1a;\">Full Property Cleanout</h2><p>Estate cleanout, foreclosure, hoarding, or rental turnover — we clear it all.</p><ul><li>Estate and inheritance cleanouts</li><li>Foreclosure property clearing</li><li>Hoarding cleanup (compassionate, discreet)</li><li>Rental property turnovers</li><li>Garage, attic, and basement clearing</li><li>Storage unit cleanouts</li></ul>\n<!-- /wp:divi/text --><!-- wp:divi/button {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"url\": {\"desktop\": {\"value\": \"/contact/\"}}}}} -->\nSchedule a Cleanout\n<!-- /wp:divi/button -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<p style=\"text-align:center;color:#999;font-style:italic;\">[Upload photo here]</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#ffffff\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"80px||80px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_2,1_2\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<p style=\"text-align:center;color:#999;font-style:italic;\">[Upload photo here]</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"font-family:Montserrat;color:#1a2e1a;\">Debris Removal &amp; Yard Cleanup</h2><p>Construction leftovers to overgrown yards — we haul it all away.</p><ul><li>Construction and renovation debris</li><li>Drywall, lumber, tile, and flooring removal</li><li>Yard waste — branches, stumps, leaves</li><li>Old fencing, sheds, and outdoor structures</li><li>Hot tub and play equipment removal</li><li>Gravel, dirt, and concrete hauling</li></ul>\n<!-- /wp:divi/text --><!-- wp:divi/button {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"url\": {\"desktop\": {\"value\": \"/contact/\"}}}}} -->\nGet a Free Estimate\n<!-- /wp:divi/button -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"gradient\": {\"stops\": [{\"color\": \"#1B5E20\", \"position\": 0}, {\"color\": \"#2E7D32\", \"position\": 100}], \"direction\": \"135deg\"}, \"type\": \"gradient\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"70px||70px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/cta {\"builderVersion\": \"5.2.1\"} -->\n<h2>Need a Custom Solution?</h2>\n<p>Contact us for a personalized plan and free estimate tailored to your needs.</p>\n<!-- /wp:divi/cta -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- /wp:divi/placeholder -->", "post_title": "TC Integrity - Services", "post_excerpt": "", "post_status": "publish", "comment_status": "closed", "ping_status": "closed", "post_password": "", "post_name": "tc-integrity-services", "to_ping": "", "pinged": "", "post_modified": "2026-04-15 05:00:00", "post_modified_gmt": "2026-04-15 05:00:00", "post_content_filtered": "", "post_parent": 0, "menu_order": 0, "post_type": "et_pb_layout", "post_mime_type": "", "comment_count": "0", "filter": "raw", "post_meta": {"_et_pb_built_for_post_type": ["page"]}, "terms": {"3": {"name": "layout", "slug": "layout", "taxonomy": "layout_type", "parent": 0, "all_parents": [], "description": ""}}}, "1003": {"ID": 1003, "post_date": "2026-04-15 05:00:00", "post_date_gmt": "2026-04-15 05:00:00", "post_content": "<!-- wp:divi/placeholder -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#1B5E20\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"120px||120px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h1 style=\"text-align:center;color:#fff;font-family:Montserrat;font-size:48px;font-weight:800;\">About T&amp;C Integrity &amp; Reliable</h1><p style=\"text-align:center;color:rgba(255,255,255,0.95);font-size:18px;\">Built on integrity. Driven by reliability. Dedicated to serving our community.</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#ffffff\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"80px||80px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_2,1_2\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<p style=\"text-align:center;color:#999;font-style:italic;\">[Upload team/founder photo here]</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"font-family:Montserrat;color:#1a2e1a;\">Our Story</h2><p>T&amp;C Integrity &amp; Reliable Trash Services was founded with a simple mission: provide honest, hardworking junk removal and cleaning services that people can actually count on.</p><p>We saw too many property managers frustrated by no-shows, hidden fees, and sloppy work. We knew there had to be a better way — and that's exactly what we built.</p><p>Today, we're the go-to eviction junk removal and deep cleaning company for property managers, landlords, and homeowners throughout the Houston metro and Central Texas.</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#f5f9f3\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"80px||80px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"text-align:center;font-family:Montserrat;color:#1a2e1a;\">Our Core Values</h2>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row --><!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_3,1_3,1_3\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>Integrity</h4>\n<p>We do what we say we'll do. Honest pricing, honest timelines, honest work — every time.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>Reliability</h4>\n<p>When we say we'll be there, we're there. On time. Prepared. Ready to work.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_3\"}}}}} -->\n<!-- wp:divi/blurb {\"builderVersion\": \"5.2.1\"} -->\n<h4>Community</h4>\n<p>We donate usable items to local shelters. We recycle responsibly. We take care of our neighbors.</p>\n<!-- /wp:divi/blurb -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#ffffff\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"80px||80px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"text-align:center;font-family:Montserrat;color:#1a2e1a;\">Why Property Managers Trust Us</h2>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row --><!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_2,1_2\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<ul><li><strong>Fast Turnaround</strong> — Most cleanouts done in 24-48 hours</li><li><strong>One-Stop Solution</strong> — Junk removal AND deep cleaning</li><li><strong>Volume Discounts</strong> — Special pricing for multiple units</li><li><strong>Before/After Docs</strong> — Photo documentation</li><li><strong>Flexible Scheduling</strong> — Early, evening, weekend</li><li><strong>Clear Communication</strong> — Updates, no ghosting</li></ul>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<ul><li><strong>Fully Insured</strong> — Liability and workers' comp</li><li><strong>Background-Checked</strong> — Every member vetted</li><li><strong>Eco-Responsible</strong> — Recycle, donate first</li><li><strong>No Hidden Fees</strong> — Quote = final price</li><li><strong>Satisfaction Guarantee</strong> — Not done until you're satisfied</li><li><strong>Property-Ready</strong> — Show-ready condition</li></ul>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"gradient\": {\"stops\": [{\"color\": \"#1B5E20\", \"position\": 0}, {\"color\": \"#2E7D32\", \"position\": 100}], \"direction\": \"135deg\"}, \"type\": \"gradient\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"70px||70px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/cta {\"builderVersion\": \"5.2.1\"} -->\n<h2>Let's Work Together</h2>\n<p>Whether you manage one property or one hundred, T&amp;C Integrity is your trusted cleanup partner.</p>\n<!-- /wp:divi/cta -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- /wp:divi/placeholder -->", "post_title": "TC Integrity - About", "post_excerpt": "", "post_status": "publish", "comment_status": "closed", "ping_status": "closed", "post_password": "", "post_name": "tc-integrity-about", "to_ping": "", "pinged": "", "post_modified": "2026-04-15 05:00:00", "post_modified_gmt": "2026-04-15 05:00:00", "post_content_filtered": "", "post_parent": 0, "menu_order": 0, "post_type": "et_pb_layout", "post_mime_type": "", "comment_count": "0", "filter": "raw", "post_meta": {"_et_pb_built_for_post_type": ["page"]}, "terms": {"3": {"name": "layout", "slug": "layout", "taxonomy": "layout_type", "parent": 0, "all_parents": [], "description": ""}}}, "1004": {"ID": 1004, "post_date": "2026-04-15 05:00:00", "post_date_gmt": "2026-04-15 05:00:00", "post_content": "<!-- wp:divi/placeholder -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#1B5E20\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"120px||120px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h1 style=\"text-align:center;color:#fff;font-family:Montserrat;font-size:48px;font-weight:800;\">Contact Us</h1><p style=\"text-align:center;color:rgba(255,255,255,0.95);font-size:18px;\">Get a free estimate or schedule your eviction cleanout and deep cleaning today.</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#ffffff\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"80px||80px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"1_2,1_2\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"font-family:Montserrat;color:#1a2e1a;\">Get in Touch</h2><p>Fill out the form and we'll get back to you within 1 business hour. For urgent requests, call us.</p><h4>Phone</h4><p><a href=\"tel:+15551234567\" style=\"color:#2E7D32;font-weight:700;font-size:1.2em;\">(555) 123-4567</a></p><h4>Email</h4><p><a href=\"mailto:info@tcintegritytrash.com\">info@tcintegritytrash.com</a></p><h4>Hours</h4><p>Monday - Saturday: 7:00 AM - 7:00 PM<br>Sunday: By Appointment Only</p><h4>Service Area</h4><p>Houston, Sugar Land, Missouri City, Katy, Cypress, Richmond, Rosenberg, College Station, Brenham, and surrounding areas.</p>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column --><!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"1_2\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<div style=\"background:#f5f9f3;padding:30px;border-radius:8px;\"><h3 style=\"font-family:Montserrat;color:#1B5E20;margin-top:0;\">Request a Free Estimate</h3><p style=\"color:#666;\">Use the Divi Contact Form module here with fields for: Name, Email, Phone, Service Needed (dropdown), Tell Us About Your Project (textarea).</p><p style=\"color:#999;font-style:italic;\">[Replace this text module with a Divi Contact Form module in the Visual Builder]</p></div>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- wp:divi/section {\"builderVersion\": \"5.2.1\", \"module\": {\"decoration\": {\"background\": {\"desktop\": {\"value\": {\"color\": \"#f5f9f3\"}}}}, \"advanced\": {\"spacing\": {\"padding\": {\"desktop\": {\"value\": \"80px||80px||true|false\"}}}}}} -->\n<!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/text {\"builderVersion\": \"5.2.1\"} -->\n<h2 style=\"text-align:center;font-family:Montserrat;color:#1a2e1a;\">Frequently Asked Questions</h2>\n<!-- /wp:divi/text -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row --><!-- wp:divi/row {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"columnStructure\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/column {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"type\": {\"desktop\": {\"value\": \"4_4\"}}}}} -->\n<!-- wp:divi/accordion {\"builderVersion\": \"5.2.1\"} -->\n<!-- wp:divi/accordion-item {\"builderVersion\": \"5.2.1\", \"module\": {\"advanced\": {\"open\": {\"desktop\": {\"value\": \"on\"}}}}} -->\n<h5>How quickly can you schedule a cleanout?</h5>\n<p>We offer same-day and next-day service for most jobs. For eviction cleanouts, we understand urgency is key — call us and we'll work to accommodate your timeline.</p>\n<!-- /wp:divi/accordion-item --><!-- wp:divi/accordion-item {\"builderVersion\": \"5.2.1\"} -->\n<h5>How much does eviction junk removal cost?</h5>\n<p>Pricing depends on volume, property size, and services needed. We provide free, no-obligation on-site estimates. No hidden fees — the price we quote is the price you pay.</p>\n<!-- /wp:divi/accordion-item --><!-- wp:divi/accordion-item {\"builderVersion\": \"5.2.1\"} -->\n<h5>Do you offer deep cleaning with junk removal?</h5>\n<p>Yes! We offer both junk removal AND deep cleaning as a combined service. One team, one schedule, one invoice — saving you time and money.</p>\n<!-- /wp:divi/accordion-item --><!-- wp:divi/accordion-item {\"builderVersion\": \"5.2.1\"} -->\n<h5>What happens to the items you remove?</h5>\n<p>Usable items are donated to local charities. Recyclable materials go to appropriate facilities. We minimize landfill waste wherever possible.</p>\n<!-- /wp:divi/accordion-item --><!-- wp:divi/accordion-item {\"builderVersion\": \"5.2.1\"} -->\n<h5>Are you licensed and insured?</h5>\n<p>Absolutely. T&amp;C Integrity is fully licensed, bonded, and insured with general liability and workers' compensation coverage.</p>\n<!-- /wp:divi/accordion-item --><!-- wp:divi/accordion-item {\"builderVersion\": \"5.2.1\"} -->\n<h5>Do you work with property management companies?</h5>\n<p>Yes — we offer volume discounts, priority scheduling, and dedicated account support for property management companies.</p>\n<!-- /wp:divi/accordion-item --><!-- wp:divi/accordion-item {\"builderVersion\": \"5.2.1\"} -->\n<h5>What areas do you serve?</h5>\n<p>Houston, Sugar Land, Missouri City, Katy, Cypress, Richmond, Rosenberg, College Station, Brenham, and surrounding communities.</p>\n<!-- /wp:divi/accordion-item -->\n<!-- /wp:divi/accordion -->\n<!-- /wp:divi/column -->\n<!-- /wp:divi/row -->\n<!-- /wp:divi/section -->\n<!-- /wp:divi/placeholder -->", "post_title": "TC Integrity - Contact", "post_excerpt": "", "post_status": "publish", "comment_status": "closed", "ping_status": "closed", "post_password": "", "post_name": "tc-integrity-contact", "to_ping": "", "pinged": "", "post_modified": "2026-04-15 05:00:00", "post_modified_gmt": "2026-04-15 05:00:00", "post_content_filtered": "", "post_parent": 0, "menu_order": 0, "post_type": "et_pb_layout", "post_mime_type": "", "comment_count": "0", "filter": "raw", "post_meta": {"_et_pb_built_for_post_type": ["page"]}, "terms": {"3": {"name": "layout", "slug": "layout", "taxonomy": "layout_type", "parent": 0, "all_parents": [], "description": ""}}}}, "presets": "", "global_colors": [], "global_variables": [], "canvases": [], "images": [], "thumbnails": []}